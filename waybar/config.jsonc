{
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/wifi",
        "custom/wwan",
        "backlight",
        "custom/audio",
        "power-profiles-daemon",
        "custom/presence",
        "custom/claude-quota",
        "custom/codex-quota",
        "custom/cpu",
        "custom/memory",
        "custom/temperature",
        "custom/battery",
        "custom/weather",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "  {}"
    },

    "sway/window": {
        "max-length": 60,
        // タイトル更新によるGTK共通のホバー待ち時間への干渉を避ける。
        "tooltip": false
    },

    "custom/wifi": {
        "exec": "$HOME/.config/waybar/scripts/wifi",
        "return-type": "json",
        "interval": 5,
        "tooltip": true
    },

    "custom/wwan": {
        "exec": "$HOME/.config/waybar/scripts/wwan",
        "return-type": "json",
        "interval": 10,
        "signal": 11,
        "on-click": "$HOME/.config/waybar/scripts/wwan-toggle",
        "on-click-right": "pkill -RTMIN+11 waybar"
    },

    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set +2%",
        "on-scroll-down": "brightnessctl set 2%-",
        "tooltip-format": "輝度: {percent}%\nスクロールで調整"
    },

    "custom/audio": {
        // 常駐して pactl subscribe の通知ごとに1行出す（interval なし）。
        "exec": "$HOME/.config/waybar/scripts/audio",
        "return-type": "json",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "power-profiles-daemon": {
        "format": " {icon}",
        "tooltip-format": "電源プロファイル: {profile}\nドライバ: {driver}\n左クリックで切替",
        "format-icons": {
            "default": "電",
            "performance": "高",
            "balanced": "均",
            "power-saver": "省"
        }
    },

    "custom/presence": {
        "exec": "$HOME/.config/waybar/scripts/presence",
        "return-type": "json",
        "interval": 5,
        "on-click": "$HOME/.config/waybar/scripts/presence toggle"
    },

    "custom/claude-quota": {
        "exec": "$HOME/.config/waybar/scripts/ai-quota --target claude",
        "return-type": "json",
        "interval": 300,
        "signal": 8,
        "on-click": "pkill -RTMIN+8 waybar"
    },

    "custom/codex-quota": {
        "exec": "$HOME/.config/waybar/scripts/ai-quota --target codex",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "pkill -RTMIN+9 waybar"
    },

    "custom/cpu": {
        "exec": "$HOME/.config/waybar/scripts/sysinfo --target cpu",
        "return-type": "json",
        "interval": 3
    },

    "custom/memory": {
        "exec": "$HOME/.config/waybar/scripts/sysinfo --target memory",
        "return-type": "json",
        "interval": 5
    },

    "custom/temperature": {
        "exec": "$HOME/.config/waybar/scripts/sysinfo --target temp",
        "return-type": "json",
        "interval": 5
    },

    "custom/battery": {
        "exec": "$HOME/.config/waybar/scripts/battery",
        "return-type": "json",
        "interval": 30,
        "signal": 12,
        "on-click": "pkill -RTMIN+12 waybar"
    },

    "custom/weather": {
        "exec": "$HOME/.config/waybar/scripts/weather",
        "return-type": "json",
        "interval": 300,
        "signal": 10,
        "on-click": "pkill -RTMIN+10 waybar"
    },

    "clock": {
        "interval": 1,
        "format": " {:%Y/%m/%d %H:%M:%S}",
        "format-alt": " {:%Y/%m/%d %H:%M:%S}",
        "tooltip-format": "<span size=\"x-large\" foreground=\"#cdd6f4\"></span>  <span size=\"large\" weight=\"bold\" foreground=\"#cdd6f4\">{0:%Y/%m/%d}</span>\n<span font_family=\"monospace\" size=\"small\" letter_spacing=\"2048\" foreground=\"#a6e3a1\">{0:%A}</span>\n\n<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "weekdays": "<span color='#7f849c'>{}</span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
