#!/usr/bin/env python3
"""Emit the built-in WWAN modem (povo SIM) status for Waybar.

ModemManager の `mmcli -J` から状態を読む。Waybar の network モジュールは
デフォルトルートの1本（通常は Wi-Fi）しか表示しないため、モバイル回線は
このスクリプトで別に出す。モデムが見つからない場合は空文字を出し、
モジュールごと非表示にする。
"""

import json
import subprocess
import sys
from typing import Any

import netinfo

TIMEOUT = 5

# Font Awesome 6 Free Solid のグリフ。style.css のフォントスタックに含まれている。
ICON_SIGNAL = ""
ICON_ERROR = "\uf071"

STATE_LABELS = {
    "connected": "接続中",
    "connecting": "接続処理中",
    "disconnecting": "切断処理中",
    "registered": "待機（未接続）",
    "searching": "圏外・探索中",
    "enabled": "有効（未登録）",
    "disabled": "無効",
    "locked": "SIM ロック中",
    "failed": "エラー",
}


def mmcli(*args: str) -> dict[str, Any] | None:
    try:
        out = subprocess.run(
            ["mmcli", "-J", *args],
            capture_output=True,
            text=True,
            timeout=TIMEOUT,
            check=True,
        ).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None


def access_label(techs: list[str]) -> str:
    # NSA 5G では lte と 5gnr が並んで返る。
    if "5gnr" in techs:
        return "5G"
    if "lte" in techs:
        return "4G"
    if any(t in techs for t in ("umts", "hsdpa", "hsupa", "hspa", "hspa-plus")):
        return "3G"
    return "--"




def build() -> dict[str, Any]:
    listing = mmcli("-L")
    paths = (listing or {}).get("modem-list") or []
    if not paths:
        return {"text": "", "tooltip": "", "class": "absent"}

    modem = (mmcli("-m", paths[0]) or {}).get("modem", {})
    generic = modem.get("generic", {})
    gpp = modem.get("3gpp", {})

    state = generic.get("state", "unknown")
    signal = generic.get("signal-quality", {}).get("value", "0")
    tech = access_label(generic.get("access-technologies", []))
    operator = gpp.get("operator-name", "--")

    ifname = None
    apn = "--"
    for bearer_path in generic.get("bearers", []):
        bearer = (mmcli("-b", bearer_path) or {}).get("bearer", {})
        if bearer.get("status", {}).get("connected") != "yes":
            continue
        ifname = bearer.get("status", {}).get("interface")
        apn = bearer.get("properties", {}).get("apn", "--")
        break

    if ifname:
        stats = netinfo.collect(ifname)
        subtitle = netinfo.activity(stats)
    else:
        stats = netinfo.Stats()
        subtitle = STATE_LABELS.get(state, state).upper()
    rows = netinfo.stat_rows(stats)
    rows.append([("Signal", f"{signal}%"), ("APN", apn)])
    tooltip = netinfo.render(
        ICON_SIGNAL, f"{operator} ({tech})" if operator != "--" else "5G Modem", subtitle, rows,
        footer=[f"状態: {STATE_LABELS.get(state, state)}", "クリックで有効/無効を切り替え"],
        stats=stats,
    )

    if state == "connected":
        text = ICON_SIGNAL
        css = "connected"
    elif state == "disabled":
        text = ICON_SIGNAL
        css = "disconnected"
    elif state == "failed":
        text = ICON_ERROR
        css = "error"
    else:
        text = ICON_SIGNAL
        css = "connecting" if state in {"connecting", "disconnecting", "searching"} else "disconnected"

    return {"text": text, "tooltip": tooltip, "class": css}


def main() -> int:
    json.dump(build(), sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
