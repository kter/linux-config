#!/usr/bin/python3
"""Display and toggle the session's presence-based screen control."""

import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys

import tooltip

UNIT = "vaio-presence-sway.service"


def systemctl(*args):
    return subprocess.run(
        ["systemctl", "--user", *args],
        check=True, capture_output=True, text=True, timeout=15,
    ).stdout.strip()


def main():
    if sys.argv[1:] == ["toggle"]:
        # Serialize rapid clicks without changing the unit's enabled state.
        runtime = Path(os.environ["XDG_RUNTIME_DIR"])
        with (runtime / "vaio-presence-toggle.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            state = systemctl("show", UNIT, "--property=ActiveState", "--value")
            systemctl("stop" if state in {"active", "activating"} else "start", UNIT)
    elif sys.argv[1:]:
        raise ValueError("usage: presence [toggle]")

    state = systemctl("show", UNIT, "--property=ActiveState", "--value")
    if state == "active":
        label, css, detail, subtitle = "ON", "enabled", "不在と無操作が30秒続くと消灯", "watching"
    elif state == "inactive":
        label, css, detail, subtitle = "OFF", "disabled", "離席による消灯を一時停止中", "paused"
    else:
        label, css, detail, subtitle = "!", "error", f"サービス状態: {state}", "error"
    icon = {"enabled": "\uf06e", "disabled": "\uf070", "error": "\uf071"}[css]
    accent = {"enabled": tooltip.ACCENT, "disabled": tooltip.WARN, "error": tooltip.CRITICAL}[css]
    rows = [[("Detection", label), ("Service", state)]]
    tip = tooltip.join(
        tooltip.header(icon, "離席検知", subtitle, accent),
        tooltip.grid(rows),
        tooltip.rule(tooltip.grid_width(rows)),
        tooltip.notes(detail, "クリックでON/OFF切替", "次回ログイン時はON", "通常の無操作ロック・消灯は引き続き有効"),
    )
    print(json.dumps({"text": icon, "class": css, "tooltip": tip}, ensure_ascii=False))

if __name__ == "__main__":
    try:
        main()
    except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
        print(f"presence: {error}", file=sys.stderr)
        print(json.dumps({
            "text": "\uf071", "class": "error",
            "tooltip": "離席検知サービスの確認・切替に失敗しました",
        }, ensure_ascii=False))
        sys.exit(1)
