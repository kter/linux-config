#!/usr/bin/sh
# NetworkManager dispatcher script: turn the WWAN radio off while Wi-Fi is
# connected, and back on when it is not.
#
# 内蔵モデムは未接続で待機しているだけでも電力を食うため、接続を切るのではなく
# 無線ごと止める。復帰時は povo 接続の autoconnect に任せる（接続を
# `nmcli connection down` で切ると NetworkManager がユーザー操作として
# autoconnect をブロックしてしまうので使わない）。
#
# 反応するのは Wi-Fi デバイスの up/down だけ。wwan0 自身の up/down は無視するので、
# Waybar から手動で WWAN を切り替えた状態は次に Wi-Fi が up/down するまで保たれる。
#
# サスペンド時は NetworkManager が sleep 状態に入ってから Wi-Fi を down させるが、
# その間に WWAN を on にしても復帰後に反映されない。さらに復帰後に Wi-Fi が
# 再接続できなかった場合は up/down が発生せず、WWAN が無効のまま残る。
# そのため sleep 中のイベントは無視し、復帰時は wwan-wifi-switch-resume.service
# から `resume` で呼んで状態を合わせ直す。sleep 中かどうかは NetworkManager の
# State だけでは取りこぼしたため、logind の PreparingForSleep も見る。
#
# インストール（root 所有・他者書き込み不可でないと NetworkManager に無視される）。
# dispatcher.d 内のファイルは SELinux で systemd から実行できないので、
# resume 用に /usr/local/sbin にも同じものを置く:
#   sudo install -m 755 -o root -g root \
#     ~/.config/NetworkManager/dispatcher.d/90-wwan-wifi-switch \
#     /etc/NetworkManager/dispatcher.d/
#   sudo install -m 755 -o root -g root \
#     ~/.config/NetworkManager/dispatcher.d/90-wwan-wifi-switch \
#     /usr/local/sbin/wwan-wifi-switch
#   sudo restorecon /usr/local/sbin/wwan-wifi-switch
#   sudo install -m 644 -o root -g root \
#     ~/.config/NetworkManager/systemd/wwan-wifi-switch-resume.service \
#     /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable wwan-wifi-switch-resume.service

export LC_ALL=C

asleep() {
    [ "$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager PreparingForSleep 2>/dev/null)" = "b true" ] ||
        [ "$(nmcli -t -f STATE general 2>/dev/null)" = asleep ]
}

wifi_connected() {
    nmcli -t -f TYPE,STATE device | grep -qx 'wifi:connected'
}

case "$1" in
    resume)
        # 復帰直後は NetworkManager がまだ sleep 中のことがあるので起きるまで待つ。
        i=0
        while asleep && [ "$i" -lt 30 ]; do
            sleep 1
            i=$((i + 1))
        done
        # Wi-Fi の再接続を少し待つ。繋がればモデムを無駄に起こさずに済む。
        i=0
        while ! wifi_connected && [ "$i" -lt 30 ]; do
            sleep 1
            i=$((i + 1))
        done
        event="resume"
        ;;
    *)
        case "$2" in
            up|down)
                ;;
            *)
                exit 0;;
        esac
        nmcli -t -f DEVICE,TYPE device | grep -qx "$1:wifi" || exit 0
        asleep && exit 0
        event="Wi-Fi state changed ($1 $2)"
        ;;
esac

if wifi_connected; then
    want=off
else
    want=on
fi

if [ "$(nmcli radio wwan)" != "$(echo "$want" | sed 's/on/enabled/;s/off/disabled/')" ]; then
    nmcli radio wwan "$want"
    logger -t wwan-wifi-switch "$event: WWAN radio $want"
fi

exit 0
